# Managed by Hermclaw – baseline nginx site for Hermclaw Next (P01 1.12).
# Static React build from {{ hermclaw_webroot }}, API proxy to {{ nginx_api_upstream }}.
# SSE endpoints are proxied unbuffered (research 20261008-014). The deployment phase
# replaces this file with infra/nginx/hermclaw-next.conf (TLS, rate limits, headers).

upstream hermclaw_api {
    server {{ nginx_api_upstream | regex_replace('^http://', '') }};
    keepalive 16;
}

server {
    listen {{ nginx_listen_port }}{{ ' default_server' if nginx_default_server | bool else '' }};
{% if nginx_listen_ipv6 | bool %}
    listen [::]:{{ nginx_listen_port }}{{ ' default_server' if nginx_default_server | bool else '' }};
{% endif %}
    server_name {{ nginx_server_name }};

    root {{ hermclaw_webroot }};
    index index.html;

    server_tokens off;
    client_max_body_size {{ nginx_client_max_body_size }};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    access_log /var/log/nginx/{{ nginx_site_name }}.access.log;
    error_log /var/log/nginx/{{ nginx_site_name }}.error.log warn;

    # Server-Sent Events: job event stream and global event stream
    location ~ ^/api/(jobs/[^/]+/)?events/stream$ {
        proxy_pass http://hermclaw_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding on;
        proxy_read_timeout {{ nginx_sse_read_timeout }};
        proxy_send_timeout {{ nginx_sse_read_timeout }};
    }

    location /api/ {
        proxy_pass http://hermclaw_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Single-page application: unknown paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
