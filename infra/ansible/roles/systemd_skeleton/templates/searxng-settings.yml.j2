# Managed by Hermclaw – SearXNG settings (research 20261008-023). The secret key comes from
# the podman secret {{ systemd_skeleton_searxng_secret_name }} (SEARXNG_SECRET), never from this file.
use_default_settings: true
general:
  instance_name: hermclaw-research
  enable_metrics: false
server:
  secret_key: "set-by-SEARXNG_SECRET"
  limiter: false
  public_instance: false
  image_proxy: false
  method: GET
search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json
outgoing:
  request_timeout: 5.0
  max_request_timeout: 15.0
