# Managed by Hermclaw – SearXNG settings (research 20261008-023, 20261014-027 S8/S9). The secret key comes
# only from the podman secret {{ systemd_skeleton_searxng_secret_name }} (SEARXNG_SECRET); this file sets none, so
# without the secret SearXNG keeps its shipped default and refuses to start instead of running with a known key.
use_default_settings: true
general:
  instance_name: hermclaw-research
  enable_metrics: false
server:
  limiter: false
  public_instance: false
  image_proxy: false
  method: GET
search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json
outgoing:
  request_timeout: 5.0
  max_request_timeout: 15.0
# More independent web engines (BUG-238): with only brave, duckduckgo and google cse, one wave of rate limits and a
# DuckDuckGo CAPTCHA (suspended 1 h) left research with zero results and failed the research steps of grand job G1.
# use_default_settings merges these entries into the shipped engine list by name.
engines:
  - name: bing
    disabled: false
  - name: yahoo
    disabled: false
