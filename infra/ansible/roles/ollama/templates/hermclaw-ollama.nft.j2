#!/usr/sbin/nft -f
{% set ports = [ollama_firewall_port | int] + ([ollama_llamacpp_port | int] if ollama_llamacpp_enabled | bool else []) %}
{% set dports = (ports[0] | string) if ports | length == 1 else ('{ ' ~ ports | join(', ') ~ ' }') %}
# Managed by Hermclaw – Ollama and llama-server have no authentication: port(s) {{ ports | join(', ') }} on {{ inventory_hostname }}
# accepts loopback and {{ ollama_firewall_allowed_sources | join(', ') if ollama_firewall_allowed_sources else 'no other source' }} only (role ollama).
# Only the table inet hermclaw_ollama is replaced (atomically); other tables and rules stay untouched.
{% set v4 = ollama_firewall_allowed_sources | select('match', '^[0-9.]+(/[0-9]+)?$') | list %}
{% set v6 = ollama_firewall_allowed_sources | reject('match', '^[0-9.]+(/[0-9]+)?$') | list %}
table inet hermclaw_ollama
delete table inet hermclaw_ollama

table inet hermclaw_ollama {
	chain input {
		type filter hook input priority -5; policy accept;
		iifname "lo" accept
{% if v4 %}
		ip saddr { {{ v4 | join(', ') }} } tcp dport {{ dports }} accept
{% endif %}
{% if v6 %}
		ip6 saddr { {{ v6 | join(', ') }} } tcp dport {{ dports }} accept
{% endif %}
		tcp dport {{ dports }} counter drop
	}
}
