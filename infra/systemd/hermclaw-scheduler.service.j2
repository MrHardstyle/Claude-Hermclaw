# Managed by Hermclaw – Hermclaw Next scheduler + agent runtime (orchestrator .225).
# Installed by the systemd_skeleton role (P01 1.13); enabled by the deployment phase.
[Unit]
Description=Hermclaw Next scheduler and agent runtime
After=network-online.target postgresql.service hermclaw-litellm.service
Wants=network-online.target postgresql.service
ConditionFileIsExecutable={{ hermclaw_venv }}/bin/hermclaw

[Service]
Type=exec
User={{ hermclaw_user }}
Group={{ hermclaw_group }}
EnvironmentFile={{ hermclaw_config_dir }}/hermclaw.env
ExecStart={{ hermclaw_venv }}/bin/hermclaw scheduler
{% for cred in systemd_skeleton_credentials.scheduler + (systemd_skeleton_worker_ids | map('regex_replace', '^', 'worker-token-') | list) %}
LoadCredentialEncrypted={{ cred }}:{{ hermclaw_credstore_dir }}/hermclaw-{{ cred }}
{% endfor %}
Restart=on-failure
RestartSec=5s
# graceful stop: running steps are checkpointed, leases released
TimeoutStopSec=90s
KillMode=mixed
UMask=0027
WorkingDirectory={{ hermclaw_data_dir }}
ReadWritePaths={{ hermclaw_data_dir }} {{ hermclaw_log_dir }}
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# AF_NETLINK: interface lookup for Wake-on-LAN broadcasts
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
