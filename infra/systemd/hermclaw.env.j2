# Managed by Hermclaw – environment of the orchestrator services (no secrets here:
# secrets are systemd credentials, referenced as cred:<name>). Mode 0640 root:{{ hermclaw_group }}.
HERMCLAW_ENV=production
HERMCLAW_INSTANCE_ID={{ systemd_skeleton_instance_id }}
HERMCLAW_CONFIG_DIR={{ hermclaw_config_dir }}
HERMCLAW_DATA_DIR={{ hermclaw_data_dir }}
# Unix socket + peer authentication: the hermclaw role has no password at all
HERMCLAW_DATABASE_URL=postgresql+psycopg://{{ hermclaw_user }}@/{{ systemd_skeleton_db_name }}?host=/run/postgresql
HERMCLAW_API_HOST={{ hermclaw_orchestrator_ip }}
HERMCLAW_API_PORT={{ hermclaw_api_port }}
HERMCLAW_LOG_JSON=true
HERMCLAW_LOG_LEVEL={{ systemd_skeleton_log_level }}
HERMCLAW_API_TOKEN_REF=cred:api-admin-token
HERMCLAW_LITELLM_KEY_REF=cred:litellm-master-key
HERMCLAW_GITLAB_TOKEN_REF=cred:gitlab-token
HERMCLAW_WORKER_TOKEN_REFS='{{ systemd_skeleton_worker_token_refs | to_json(separators=(",", ":")) }}'
