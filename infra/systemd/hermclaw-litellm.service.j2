# Managed by Hermclaw – LiteLLM gateway (orchestrator .225, research 20261008-006).
# Config: {{ hermclaw_config_dir }}/litellm.yaml (generated by `hermclaw litellm-config`).
# The master key is a systemd credential exported as LITELLM_MASTER_KEY by hermclaw-cred-env.
[Unit]
Description=Hermclaw LiteLLM gateway
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable={{ systemd_skeleton_litellm_venv }}/bin/litellm
ConditionPathExists={{ hermclaw_config_dir }}/litellm.yaml

[Service]
Type=exec
User={{ hermclaw_user }}
Group={{ hermclaw_group }}
Environment=LITELLM_LOG=INFO
# bundled model cost map instead of a download from GitHub at every start; no admin UI login path (R-027 L11)
Environment=LITELLM_LOCAL_MODEL_COST_MAP=True
Environment=DISABLE_ADMIN_UI=True
Environment=HOME={{ hermclaw_data_dir }}
LoadCredentialEncrypted=litellm-master-key:{{ hermclaw_credstore_dir }}/hermclaw-litellm-master-key
ExecStart={{ hermclaw_bin_dir }}/hermclaw-cred-env LITELLM_MASTER_KEY=litellm-master-key -- {{ systemd_skeleton_litellm_venv }}/bin/litellm --config {{ hermclaw_config_dir }}/litellm.yaml --host {{ systemd_skeleton_litellm_bind }} --port {{ hermclaw_litellm_port }}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
WorkingDirectory={{ hermclaw_data_dir }}
ReadWritePaths={{ hermclaw_data_dir }}
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
