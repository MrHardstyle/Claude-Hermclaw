# Managed by Hermclaw – execution worker daemon (.222). Runs sandbox commands with rootless
# Podman as {{ hermclaw_user }} (lingering user manager, delegated cgroup v2 controllers).
# Installed by the systemd_skeleton role (P01 1.13); enabled by the deployment phase.
[Unit]
Description=Hermclaw Next execution worker
After=network-online.target user@{{ systemd_skeleton_hermclaw_uid }}.service
Wants=network-online.target user@{{ systemd_skeleton_hermclaw_uid }}.service
ConditionFileIsExecutable={{ hermclaw_venv }}/bin/hermclaw-exec-worker

[Service]
Type=exec
User={{ hermclaw_user }}
Group={{ hermclaw_group }}
EnvironmentFile={{ hermclaw_config_dir }}/worker.env
# rootless Podman talks to the user's systemd instance for container cgroups
# (%U would be root's UID in a system unit, so the UID is rendered by Ansible)
Environment=XDG_RUNTIME_DIR=/run/user/{{ systemd_skeleton_hermclaw_uid }}
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ systemd_skeleton_hermclaw_uid }}/bus
Environment=HOME={{ hermclaw_home }}
LoadCredentialEncrypted=worker-token:{{ hermclaw_credstore_dir }}/hermclaw-worker-token
ExecStart={{ hermclaw_venv }}/bin/hermclaw-exec-worker
Restart=on-failure
RestartSec=5s
# the worker stops its own containers; mixed lets it do so before SIGKILL
KillMode=mixed
TimeoutStopSec=60s
UMask=0027
WorkingDirectory={{ hermclaw_data_dir }}
# Rootless Podman needs user namespaces and the setuid newuidmap/newgidmap helpers. For a User= service systemd
# implies NoNewPrivileges for every one of ProtectKernelTunables/-Modules/-Logs, ProtectClock, ProtectHostname,
# RestrictRealtime, LockPersonality, SystemCallArchitectures, RestrictAddressFamilies, RestrictSUIDSGID,
# RestrictNamespaces, PrivateDevices, SystemCallFilter and MemoryDenyWriteExecute (systemd 257
# context_has_no_new_privileges, research 20261014-029 C2/C16), which breaks newuidmap - so only mount-namespace
# protections are used here (no ProtectHome: it hides /run/user). Isolation of the executed code comes from the
# sandbox (--network=none, --cap-drop=ALL, --security-opt=no-new-privileges, read-only rootfs, rootless userns).
ProtectSystem=full

[Install]
WantedBy=multi-user.target
