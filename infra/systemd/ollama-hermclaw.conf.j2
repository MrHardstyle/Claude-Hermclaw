# Managed by Hermclaw – Ollama settings for the model worker (research 20261008-007).
# OLLAMA_CONTEXT_LENGTH stays unset on purpose: Hermclaw sends num_ctx with every request.
[Service]
{% if ollama_install_method == 'tarball' %}
ExecStart=
ExecStart={{ ollama_bin }} serve
{% endif %}
Environment=OLLAMA_HOST={{ ollama_listen }}
Environment=OLLAMA_KEEP_ALIVE={{ ollama_keep_alive }}
Environment=OLLAMA_MAX_LOADED_MODELS={{ ollama_max_loaded_models }}
Environment=OLLAMA_NUM_PARALLEL={{ ollama_num_parallel }}
Environment=OLLAMA_MODELS={{ ollama_effective_models_dir }}
{% if ollama_flash_attention | string | lower != 'auto' %}
Environment=OLLAMA_FLASH_ATTENTION={{ '1' if ollama_flash_attention | bool else '0' }}
{% endif %}
{% if ollama_kv_cache_type | length > 0 %}
Environment=OLLAMA_KV_CACHE_TYPE={{ ollama_kv_cache_type }}
{% endif %}
Environment=OLLAMA_LOAD_TIMEOUT={{ ollama_load_timeout }}
{% if ollama_no_cloud | bool %}
Environment=OLLAMA_NO_CLOUD=1
{% endif %}
Environment=OLLAMA_VULKAN={{ '1' if ollama_vulkan | bool else '0' }}
{% if ollama_llamacpp_enabled | default(false) | bool %}
# the GPU belongs to the resident llama-server (D-015): Ollama serves only the embedding model, on the CPU. On the GPU
# it would take the free VRAM in the gap of a model swap and the next llama.cpp model failed with OOM (BUG-313)
Environment=CUDA_VISIBLE_DEVICES=-1
{% endif %}
{% for key, value in ollama_extra_env | dictsort %}
Environment={{ key }}={{ value }}
{% endfor %}
UnsetEnvironment=OLLAMA_CONTEXT_LENGTH
