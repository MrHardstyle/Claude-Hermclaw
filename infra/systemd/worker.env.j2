# Managed by Hermclaw – environment of the {{ systemd_skeleton_worker_kind }} worker daemon (no secrets:
# the token is the systemd credential worker-token). Mode 0640 root:{{ hermclaw_group }}.
HERMCLAW_ENV=production
WORKER_ID={{ systemd_skeleton_worker_id }}
WORKER_KIND={{ systemd_skeleton_worker_kind }}
WORKER_BIND={{ systemd_skeleton_worker_bind }}:{{ hermclaw_worker_port }}
ORCHESTRATOR_URL=http://{{ hermclaw_orchestrator_ip }}:{{ hermclaw_api_port }}
WORKER_DATA_DIR={{ hermclaw_data_dir }}/worker
WORKER_CAPABILITIES_FILE={{ hermclaw_config_dir }}/capabilities.yaml
WORKER_LOG_JSON=true
WORKER_LOG_LEVEL={{ systemd_skeleton_log_level }}
{% if systemd_skeleton_worker_kind == 'execution' %}
WORKER_POLICIES_FILE={{ hermclaw_config_dir }}/policies.yaml
{% endif %}
{% if systemd_skeleton_worker_kind == 'model' %}
OLLAMA_URL=http://127.0.0.1:{{ hermclaw_ollama_port }}
{% endif %}
