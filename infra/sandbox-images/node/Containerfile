# Hermclaw sandbox toolchain: Node.js / TypeScript (R-022).
FROM docker.io/library/node:22-bookworm-slim
ENV HOME=/tmp NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
RUN npm install -g "typescript@>=5.9 <7" && npm cache clean --force && tsc --version && node --version
LABEL org.hermclaw.sandbox="node"
