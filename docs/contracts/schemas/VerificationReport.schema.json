{
  "$defs": {
    "VerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "check_type": {
          "description": "scope|forbidden|syntax|compile|lint|unit|integration|secrets|conflicts|presence|absence|command|test|diff|schema|artifact|generated|changed_files|deletions|test_evidence",
          "title": "Check Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skip",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "check_type",
        "name",
        "status"
      ],
      "title": "VerificationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "changed_files": {
      "items": {
        "type": "string"
      },
      "title": "Changed Files",
      "type": "array"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "passed",
    "checks"
  ],
  "title": "VerificationReport",
  "type": "object"
}
