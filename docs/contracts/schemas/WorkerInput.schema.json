    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
