{
  "$defs": {
    "ToolName": {
      "enum": [
        "list_files",
        "read_file",
        "read_range",
        "find_text",
        "search_repo",
        "search_symbol",
        "git_status",
        "git_diff",
        "write_file",
        "replace_text",
        "apply_patch",
        "run_command",
        "run_test",
        "request_scope_expansion",
        "request_research",
        "request_replan",
        "checkpoint",
        "complete_step",
        "block_step"
      ],
      "title": "ToolName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Exactly one action per turn. ``status`` is a short, user-visible progress note (no reasoning).",
  "properties": {
    "tool": {
      "$ref": "#/$defs/ToolName"
    },
    "args": {
      "additionalProperties": true,
      "title": "Args",
      "type": "object"
    },
    "status": {
      "default": "",
      "maxLength": 300,
      "title": "Status",
      "type": "string"
    },
    "decision": {
      "default": "",
      "description": "short decision label, e.g. 'fix-import'",
      "maxLength": 120,
      "title": "Decision",
      "type": "string"
    }
  },
  "required": [
    "tool"
  ],
  "title": "CoderAction",
  "type": "object"
}
