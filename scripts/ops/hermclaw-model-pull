#!/usr/bin/env bash
# hermclaw-model-pull – pull and verify the fixed Hermclaw model set on the model host (.224).
#
# Usage: hermclaw-model-pull [--dry-run] [--ollama BIN] [--skip-fallback-planner] [--embedding TAG]
#
# Roles (fixed by architecture; see config/models.yaml):
#   planner           gemma4:26b          planner fallback  gemma4:12b
#   coder             qwen3-coder:30b     heavy reviewer    qwen3.8:27b
#   fast router       qwen3:8b            embedding         embeddinggemma:300m (768 dim, 2048 ctx)
#
# --embedding TAG tries another embedding model first (e.g. embeddinggemma-2:740m once Ollama runs it on Linux/CUDA –
# today it is MLX-only, research 20261014-026) and falls back to embeddinggemma:300m.
#
# Every role model must pull and pass `ollama show`; a missing role model is a hard error (exit 1).
# Only the embedding model has a fallback; when it is used the script prints the models.yaml change to make
# on .225 (profile `embedding`, `model:`). Exit codes: 0 ok, 1 role model missing, 2 usage.
set -euo pipefail

OLLAMA="${OLLAMA_BIN:-ollama}"
DRY=0
PLANNER_FALLBACK=1
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --ollama) OLLAMA="$2"; shift ;;
    --skip-fallback-planner) PLANNER_FALLBACK=0 ;;
    --embedding) EMBEDDING_PRIMARY="$2"; shift ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

ROLE_MODELS=(gemma4:26b qwen3-coder:30b qwen3.8:27b qwen3:8b)
[ "$PLANNER_FALLBACK" = 1 ] && ROLE_MODELS+=(gemma4:12b)
EMBEDDING_FALLBACK="embeddinggemma:300m"
EMBEDDING_PRIMARY="${EMBEDDING_PRIMARY:-$EMBEDDING_FALLBACK}"

run() { if [ "$DRY" = 1 ]; then echo "+ $*"; else "$@"; fi; }

pull_and_check() {
  local tag="$1"
  echo "==> $tag"
  if ! run "$OLLAMA" pull "$tag"; then
    return 1
  fi
  if [ "$DRY" = 0 ] && ! "$OLLAMA" show "$tag" >/dev/null 2>&1; then
    echo "    ollama show $tag failed" >&2
    return 1
  fi
  echo "    ok"
}

missing=()
for tag in "${ROLE_MODELS[@]}"; do
  pull_and_check "$tag" || missing+=("$tag")
done

embedding=""
if pull_and_check "$EMBEDDING_PRIMARY"; then
  embedding="$EMBEDDING_PRIMARY"
elif [ "$EMBEDDING_PRIMARY" != "$EMBEDDING_FALLBACK" ]; then
  echo "    $EMBEDDING_PRIMARY not available – falling back to $EMBEDDING_FALLBACK (same 768 dimensions)" >&2
  pull_and_check "$EMBEDDING_FALLBACK" && embedding="$EMBEDDING_FALLBACK"
fi
if [ -z "$embedding" ]; then
  missing+=("embedding:$EMBEDDING_PRIMARY")
elif [ "$embedding" != "$EMBEDDING_FALLBACK" ]; then
  echo
  echo "ACTION on .225: set the embedding profile in /etc/hermclaw/models.yaml to"
  echo "    model: $embedding"
  echo "then: hermclaw litellm-config /etc/hermclaw/litellm.yaml && systemctl restart hermclaw-litellm hermclaw-scheduler"
fi

echo
if [ "${#missing[@]}" -gt 0 ]; then
  echo "MISSING role models: ${missing[*]}" >&2
  exit 1
fi
echo "all models present (embedding: $embedding)"
[ "$DRY" = 1 ] || "$OLLAMA" list
